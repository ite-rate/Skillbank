#!/bin/sh
# Skillbank CLI 入口 — 无需 pip install 的 fallback wrapper
# 自动把 repo 的 src/ 加进 PYTHONPATH, 让 `python3 -m skillbank.cli` 永远能跑。
#
# 推荐(可选): pip install -e <repo>  之后 `skillbank` 在 PATH 里, 跑得更快
# 临时用(无需装): `<repo>/bin/skillbank <command>`

# bin/ -> repo root
REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)
exec env PYTHONPATH="$REPO_ROOT/src" python3 -m skillbank.cli "$@"